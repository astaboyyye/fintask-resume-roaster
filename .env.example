# Copy to .env.local for local development. Never commit real values.

# --- NextAuth (required) ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# GitHub OAuth app. Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Optional Google sign-in. Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Claude API (required for AI feedback; without it the app uses simple local checks) ---
ANTHROPIC_API_KEY=""

# --- Supabase (required to save roasts and enforce a shared rate limit) ---
# Project Settings > API. The service role key is server-only: never expose it to the browser.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: roasts allowed per user per hour (default 5)
ROAST_LIMIT_PER_HOUR="5"
