# Supabase transaction pooler URL (port 6543, include ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase direct or session pooler URL (port 5432) for migrations
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST.pooler.supabase.com:5432/postgres"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
GITHUB_ID="your-github-oauth-client-id"
GITHUB_SECRET="your-github-oauth-client-secret"
GROQ_API_KEY="your-groq-api-key"
# Vercel only: opt in to request bodies above 4.5 MB (requires 4 GB Performance memory)
VERCEL_SUPPORT_LARGE_REQUEST_BODY="1"
